# Required. The secret path segment: every URL is https://<host>/<key>/...
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
YTM_SECRET_KEY=
# Required. The public base URL (no trailing slash), used for links and the allowed Host.
YTM_PUBLIC_URL=https://transcripts.example.com
# Bind address (put a reverse proxy or tunnel in front).
YTM_HOST=127.0.0.1
YTM_PORT=8090
# Where the database and .md files live.
YTM_DATA_DIR=./data
# Path to a Netscape cookies.txt owned by THIS service alone (yt-dlp rewrites it). Optional.
YTM_COOKIES=
# Seconds a single fetch may take before it is killed. Typical fetches take 5-10 s.
# FETCH_TIMEOUT + LOCK_WAIT must be at most 95: Cloudflare (and most proxies) cut a
# request that sends nothing for about 100 s.
YTM_FETCH_TIMEOUT=60
# Seconds a second request waits for the one running fetch before answering "busy".
YTM_LOCK_WAIT=25
# Video used by `python -m ytmcp.check` (the weekly yt-dlp health check). Optional.
YTM_CHECK_VIDEO=dQw4w9WgXcQ
